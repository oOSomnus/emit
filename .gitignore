node_modules/
dist/
data/
*.log
.DS_Store

# Environment: real values stay local, .env.example is tracked.
.env
.env.local
.env.*.local

# Smoke-run scratch data (recreated by tmp/smoke.mjs).
tmp/smoke-data/
tmp/smoke-work/
tmp/smoke-outside/
tmp/ui-*/

# Local UI inspection captures; keep durable design context and configuration.
.impeccable/review/

# Emit runtime state when the data directory points inside the repository:
# the SQLite store, its WAL sidecars, the single-instance lock, and the
# 0600 credential file. The default data directory is ~/.emit, outside the repo.
*.sqlite
*.sqlite-wal
*.sqlite-shm
emit.lock

# Test, coverage, and browser artifacts are reproducible local outputs.
coverage/
test-results/
playwright-report/
credentials.json

megalinter-reports/
*.megalinter-setup.bak

# Agent tooling installed into this checkout (MegaLinter skills and their lock
# file) stays local: it is not part of the application or its CI inputs.
.agents/
skills-lock.json
