node_modules/
dist/
data/
*.log
.DS_Store

# Environment: real values stay local, .env.example is tracked.
.env
.env.local
.env.*.local

# Smoke-run scratch data (recreated by tmp/smoke.mjs).
tmp/smoke-data/
tmp/smoke-work/
