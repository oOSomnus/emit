{
  "name": "emit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local digital-employee collaboration workspace built on Pi Durable",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch src/server/main.ts",
    "dev:web": "vite build --watch",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "start": "tsx src/server/main.ts",
    "postinstall": "node scripts/apply-pi-durable-patch.mjs",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@earendil-works/pi-durable": "1.0.0",
    "@earendil-works/pi-mcp": "1.0.0",
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  }
}
