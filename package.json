{
  "name": "emit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local digital-employee collaboration workspace built on Pi Durable",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch src/server/main.ts",
    "dev:web": "vite build --watch",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "start": "tsx src/server/main.ts",
    "postinstall": "node scripts/apply-pi-durable-patch.mjs",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && tsc -p tsconfig.browser.json",
    "lint": "eslint 'src/**/*.{js,cjs,mjs,ts,tsx}' 'scripts/**/*.{js,cjs,mjs,ts,tsx}' 'test/**/*.{js,cjs,mjs,ts,tsx}' '*.config.ts' 'eslint.config.mjs' --max-warnings 0",
    "test": "vitest run --project core --project integration --project api --project e2e",
    "test:watch": "vitest --project core --project integration --project api --project e2e",
    "test:unit": "vitest run --project core",
    "test:integration": "vitest run --project integration",
    "test:api": "vitest run --project api",
    "test:e2e": "vitest run --project e2e",
    "test:fault": "vitest run --project fault",
    "test:stress": "vitest run --project stress",
    "test:coverage": "vitest run --project core --project integration --project api --project e2e --coverage",
    "test:browser": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:browser:all": "playwright test",
    "test:native": "npm run build && node scripts/build-binary.mjs && node test/native-binary.smoke.mjs",
    "test:gate": "node scripts/run-test-gate.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@earendil-works/pi-durable": "1.0.0",
    "@earendil-works/pi-mcp": "1.0.0",
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "postject": "1.0.0-alpha.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  }
}
